# Copia este archivo a .env.local y rellena los valores reales.
# Ambas variables se leen solo en el servidor: nunca uses el prefijo NEXT_PUBLIC_.

# Clave de API de la cuenta de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Único destinatario de los mensajes del formulario de contacto.
# Con el remitente onboarding@resend.dev, Resend solo entrega al correo
# dueño de la cuenta: debe ser exactamente ese correo.
CONTACT_TO_EMAIL=tu@correo.com

# Supabase (Project Settings > API). La clave publishable es pública por diseño:
# la seguridad real la dan las políticas RLS de cada tabla.
NEXT_PUBLIC_SUPABASE_URL=https://zrjbpefaerinjcctowcz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
